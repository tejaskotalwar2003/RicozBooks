# ==============================================================================
# RicozBooks SaaS — Staging Environment Configuration Template
# ==============================================================================

# Node Environment
NODE_ENV=staging
PORT=8000

# Backend Express API Configuration
API_PREFIX=/api/v1
APP_VERSION=1.3.0
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_in_staging
JWT_EXPIRES_IN=24h

# MongoDB Atlas Connection String (Replica Set required for multi-document ACID transactions)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://ricoz_staging_admin:SECURE_STAGING_PASSWORD@cluster0.mongodb.net/ricozbooks_staging?retryWrites=true&w=majority

# CORS Origins (Comma-separated allowed browser domains)
CORS_ORIGIN=https://ricozbooks-web-staging.onrender.com,http://localhost:3000

# Super Administrator Seed Credentials (For initial bootstrap of Developer Console)
SUPERADMIN_EMAIL=admin@ricoz.in
SUPERADMIN_PASSWORD=ReplaceWithStrongMasterSecret2026!
SUPERADMIN_NAME=Platform Super Administrator

# Frontend Configuration (Used by apps/web during build & runtime)
NEXT_PUBLIC_API_URL=https://ricozbooks-api-staging.onrender.com
NEXT_PUBLIC_APP_ENV=staging

