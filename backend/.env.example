# RicozBooks Backend Environment Variables

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgresql@localhost:5432/ricozbooks_db

# Security & Session Secrets
SECRET_KEY=ricozbooks_super_secure_jwt_secret_key_2026_enterprise_finance

# Frontend URL (Used for generating absolute invitation & invoice links)
# Production: https://ricozbooks-web.onrender.com
# Local dev: http://localhost:5173
FRONTEND_URL=https://ricozbooks-web.onrender.com

# ==============================================================================
# Transactional Email / SMTP Configuration
# Supported providers: SendGrid, Mailgun, Amazon SES, Postmark, Zoho, Gmail, etc.
# ==============================================================================
# SMTP Server hostname (leave empty/unconfigured for manual link copy only)
SMTP_HOST=
# SMTP Server port (587 for STARTTLS, 465 for SSL)
SMTP_PORT=587
# SMTP Authentication username / API Key
SMTP_USER=
# SMTP Authentication password / Secret Key
SMTP_PASSWORD=
# Outbound sender email address
SMTP_FROM_EMAIL=notifications@ricozbooks.com
# Outbound sender display name
SMTP_FROM_NAME=RicozBooks
# Enable STARTTLS (default: true)
SMTP_TLS=true
# Enable SSL direct connection on port 465 (default: false)
SMTP_SSL=false

