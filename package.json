{
  "name": "ricozbooks-monorepo",
  "version": "1.3.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build --workspace=@ricozbooks/shared",
    "build:api": "npm run build --workspace=@ricozbooks/shared && npm run build --workspace=@ricozbooks/api",
    "build:web": "npm run build --workspace=@ricozbooks/shared && npm run build --workspace=@ricozbooks/web",
    "start:api": "node apps/api/dist/server.js",
    "start:web": "npm run start --workspace=@ricozbooks/web",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm test --workspace=@ricozbooks/api",
    "dev:api": "npm run dev --workspace=@ricozbooks/api",
    "dev:web": "npm run dev --workspace=@ricozbooks/web",
    "start": "node scripts/start-all.js",
    "dev": "node scripts/dev-all.js"
  }
}

